<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="16" stylesheets="@../css/style.css" styleClass="tab-content"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.vaultdesk.controller.PasswordController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="560">
        <TextField fx:id="searchField" promptText="🔍 Search, or try tag:work" onKeyReleased="#handleSearch"/>
        <TableView fx:id="credentialTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="websiteColumn" text="Website" prefWidth="130"/>
                <TableColumn fx:id="usernameColumn" text="Username" prefWidth="130"/>
                <TableColumn fx:id="passwordColumn" text="Password" prefWidth="90"/>
                <TableColumn fx:id="strengthColumn" text="Strength" prefWidth="110"/>
                <TableColumn fx:id="tagsColumn" text="Tags" prefWidth="120"/>
            </columns>
        </TableView>
        <HBox spacing="8">
            <Button text="📋 Copy" onAction="#handleCopy" styleClass="primary-button"/>
            <Button text="👁 View" onAction="#handleView"/>
            <Button text="✏ Edit" onAction="#handleEdit"/>
            <Button text="🗑 Delete" onAction="#handleDelete" styleClass="danger-button"/>
        </HBox>
    </VBox>

    <VBox spacing="10" styleClass="card" prefWidth="320">
        <Label styleClass="section-title" text="+ Add / Edit Entry"/>
        <TextField fx:id="websiteField" promptText="Website"/>
        <TextField fx:id="entryUsernameField" promptText="Username"/>
        <TextField fx:id="entryPasswordField" promptText="Password"/>
        <TextField fx:id="tagsField" promptText="Tags, comma separated (e.g. work, github)"/>
        <Button text="🎲 Generate Password" onAction="#handleGenerate" styleClass="secondary-button" maxWidth="Infinity"/>

        <Separator/>
        <Label text="Generator Options"/>
        <Slider fx:id="lengthSlider" min="8" max="32" value="16" showTickLabels="true" majorTickUnit="8"/>
        <CheckBox fx:id="upperCheck" text="Uppercase (A-Z)" selected="true"/>
        <CheckBox fx:id="lowerCheck" text="Lowercase (a-z)" selected="true"/>
        <CheckBox fx:id="digitsCheck" text="Numbers (0-9)" selected="true"/>
        <CheckBox fx:id="symbolsCheck" text="Symbols (!@#$)" selected="true"/>

        <Separator/>
        <Button text="💾 Save Entry" onAction="#handleSave" styleClass="primary-button" maxWidth="Infinity"/>
        <Button text="Clear Form" onAction="#handleClear" styleClass="link-button" maxWidth="Infinity"/>
        <Label fx:id="formStatusLabel" wrapText="true"/>
    </VBox>
</HBox>
